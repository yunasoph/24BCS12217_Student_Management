{
  "info": {
    "name": "Student Management REST API",
    "description": "Postman Collection for testing all Student Management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Add a new student (POST /api/students)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice.johnson@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 21\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/students",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "2. Retrieve all students (GET /api/students)",
